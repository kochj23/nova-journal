{{- /* Slim search index (2026-10-19). Was: full summary HTML + the first 1500 chars of .Plain + tags
       per page (~11 MB live). Now one small record per page — title, url (relative), section, date
       (YYYY-MM-DD) and a ~300-char plain-text summary with the "Published …" byline and the weather
       dateline stripped. assets/js/fastsearch.js (project override) searches title + summary and
       filters by section/date; nova_journal_digest_email.py reads this same file. */ -}}
{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) -}}
        {{- $s := partial "nova_plain_summary.html" . | truncate 300 -}}
        {{- $index = $index | append (dict "title" .Title "url" .RelPermalink "section" .Section "date" (.Date.Format "2006-01-02") "summary" $s) -}}
    {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
